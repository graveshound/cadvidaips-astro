---
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="Página no encontrada - CADVIDA IPS"
  description="La página que estás buscando no existe."
>
  <div class="grid min-h-[70vh] place-items-center bg-white px-6 py-24 sm:py-32 lg:px-8 pt-32">
    <div class="text-center">
      <img
        src="/assets/images/logo.png"
        alt="CADVIDA IPS Logo"
        class="mx-auto h-24 w-auto mb-8"
      />
      <p class="text-base font-semibold text-blue-600">404</p>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-900 sm:text-5xl">Página no encontrada</h1>
      <p class="mt-6 text-base leading-7 text-gray-600">Lo sentimos, no pudimos encontrar la página que estás buscando.</p>
      <div class="mt-10 flex items-center justify-center gap-x-6">
        <a href="/" class="rounded-md bg-blue-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 transition-colors">
          Regresar al inicio
        </a>
      </div>
    </div>
  </div>
</Layout>
