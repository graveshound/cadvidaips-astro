---

---

<footer
  class="relative overflow-hidden bg-brand-blue text-white w-full rounded-t-[3rem]"
>
  <!-- Decorative background elements -->
  <div class="absolute top-0 left-0 w-full h-full overflow-hidden z-0">
    <div
      class="absolute top-[-20%] left-[-10%] w-64 h-64 bg-brand-blue-light/30 rounded-full mix-blend-screen filter blur-[80px]"
    >
    </div>
    <div
      class="absolute bottom-[-20%] right-[-10%] w-80 h-80 bg-brand-green/20 rounded-full mix-blend-screen filter blur-[100px]"
    >
    </div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 pb-8 pt-16 sm:pt-24 lg:px-8">
    <div class="xl:grid xl:grid-cols-3 xl:gap-8 border-b border-white/10 pb-12">
      <div
        class="space-y-8 xl:col-span-1 flex flex-col items-center xl:items-start"
      >
        <img
          src="/assets/images/isologo.png"
          alt="CADVIDA IPS"
          class="h-16 brightness-0 invert opacity-90"
        />
        <p
          class="text-sm leading-6 text-blue-100 text-center xl:text-left max-w-xs"
        >
          Más de 14 años transformando vidas con atención integral en salud
          mental y rehabilitación.
        </p>
        <div class="flex space-x-6">
          <a
            href="https://www.facebook.com/profile.php?id=61578581024222"
            target="_blank"
            rel="noopener noreferrer"
            class="text-blue-200 hover:text-white transition-colors bg-white/5 p-3 rounded-full hover:bg-white/10"
          >
            <span class="sr-only">Facebook</span>
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
          <a
            href="https://www.instagram.com/cadvida/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-blue-200 hover:text-white transition-colors bg-white/5 p-3 rounded-full hover:bg-white/10"
          >
            <span class="sr-only">Instagram</span>
            <img
              src="/assets/images/instagram.png"
              alt="Instagram"
              class="h-6 w-6 brightness-0 invert"
            />
          </a>
          <a
            href="https://wa.link/t6f9nc"
            target="_blank"
            rel="noopener noreferrer"
            class="text-blue-200 hover:text-white transition-colors bg-white/5 p-3 rounded-full hover:bg-white/10"
          >
            <span class="sr-only">WhatsApp</span>
            <img
              src="/assets/images/whatsapp.png"
              alt="WhatsApp"
              class="h-6 w-6 brightness-0 invert"
            />
          </a>
        </div>

      </div>
      <div class="mt-16 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3
              class="text-sm font-semibold leading-6 text-white tracking-wider uppercase font-heading"
            >
              Navegación
            </h3>
            <ul role="list" class="mt-6 space-y-4">
              <li>
                <a
                  href="/"
                  class="text-sm leading-6 text-blue-200 hover:text-white transition-colors"
                  >Inicio</a
                >
              </li>
              <li>
                <a
                  href="/servicios"
                  class="text-sm leading-6 text-blue-200 hover:text-white transition-colors"
                  >Servicios</a
                >
              </li>
              <li>
                <a
                  href="/quienes-somos"
                  class="text-sm leading-6 text-blue-200 hover:text-white transition-colors"
                  >Quiénes somos</a
                >
              </li>
              <li>
                <a
                  href="/contacto"
                  class="text-sm leading-6 text-blue-200 hover:text-white transition-colors"
                  >Sedes y Contacto</a
                >
              </li>
            </ul>
          </div>
          <div class="mt-10 md:mt-0">
            <h3
              class="text-sm font-semibold leading-6 text-white tracking-wider uppercase font-heading"
            >
              Legal
            </h3>
            <ul role="list" class="mt-6 space-y-4">
              <li>
                <a
                  href="/politicas"
                  class="text-sm leading-6 text-blue-200 hover:text-white transition-colors"
                  >Políticas de Privacidad</a
                >
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div
      class="mt-8 flex justify-between items-center flex-col sm:flex-row gap-4"
    >
      <p class="text-xs leading-5 text-blue-200">
        &copy; {new Date().getFullYear()} CADVIDA IPS SAS. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
